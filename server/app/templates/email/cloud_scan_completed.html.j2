<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cloud Security Scan Complete & Attack Graph Generated</title>
  </head>
  <body style="margin:0;padding:0;background-color:#0b0714;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#f3effc;line-height:1.5;">
    <span style="display:none!important;visibility:hidden;opacity:0;color:transparent;height:0;width:0">{{ preheader | default('Cloud Security Scan Completed — Attack Graph & Executive Summary Ready') }}</span>
    
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#0b0714;padding:36px 12px;">
      <tr>
        <td align="center">
          <!-- Main Card Container -->
          <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:620px;background:#150f22;border-radius:20px;border:1px solid #2d1f4d;box-shadow:0 20px 45px rgba(0,0,0,0.6);overflow:hidden;">
            
            <!-- Top Gradient Accent Line -->
            <tr>
              <td style="height:6px;background:linear-gradient(90deg,#9333ea 0%,#6366f1 50%,#06b6d4 100%);"></td>
            </tr>

            <!-- Header Section -->
            <tr>
              <td style="padding:32px 32px 20px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td>
                      <div style="font-size:11px;letter-spacing:0.32em;text-transform:uppercase;color:#c084fc;font-weight:800;">VRIKA CLOUD SECURITY</div>
                      <h1 style="margin:8px 0 4px;font-size:24px;line-height:1.25;font-weight:800;color:#ffffff;letter-spacing:-0.02em;">
                        Cloud Scan &amp; Attack Graph Ready
                      </h1>
                      <p style="margin:0;font-size:14px;color:#a79bc2;">
                        Scan completed for <strong style="color:#ffffff;">{{ organization_name }}</strong>. Threat model &amp; attack paths generated.
                      </p>
                    </td>
                    <td align="right" valign="top" style="padding-left:16px;">
                      <span style="display:inline-block;padding:6px 14px;background:#052e16;border:1px solid #166534;border-radius:999px;font-size:11px;font-weight:800;color:#4ade80;text-transform:uppercase;letter-spacing:0.08em;">
                        ● Completed
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Metadata Banner -->
            <tr>
              <td style="padding:0 32px 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#1d1430;border:1px solid #36245e;border-radius:12px;padding:14px 18px;">
                  <tr>
                    <td style="font-size:13px;color:#c7bbdf;">
                      <div><strong style="color:#ffffff;">Cloud Provider:</strong> {{ provider | upper }}</div>
                      <div style="margin-top:4px;"><strong style="color:#ffffff;">Account / Target:</strong> {{ account_id }} {% if account_name %}({{ account_name }}){% endif %}</div>
                    </td>
                    <td align="right" style="font-size:12px;color:#8f82aa;">
                      <div><strong>Scan ID:</strong> {{ scan_id }}</div>
                      <div style="margin-top:4px;">{{ completed_at | default('Just now') }}</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Executive KPI Cards (3-column) -->
            <tr>
              <td style="padding:0 32px 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <!-- Compliance Score -->
                    <td width="31%" style="background:#1c132f;border:1px solid #3d266e;border-radius:14px;padding:16px;text-align:center;">
                      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#a79bc2;">Compliance Score</div>
                      <div style="font-size:28px;font-weight:900;color:{% if compliance_score >= 80 %}#4ade80{% elif compliance_score >= 60 %}#facc15{% else %}#f87171{% endif %};margin-top:6px;">
                        {{ compliance_score }}%
                      </div>
                      <div style="font-size:11px;color:#7e729a;margin-top:2px;">Post-Scan Health</div>
                    </td>
                    <td width="3%"></td>
                    <!-- Scanned Resources -->
                    <td width="31%" style="background:#1c132f;border:1px solid #3d266e;border-radius:14px;padding:16px;text-align:center;">
                      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#a79bc2;">Scanned Assets</div>
                      <div style="font-size:28px;font-weight:900;color:#38bdf8;margin-top:6px;">
                        {{ scanned_resources | default('100+') }}
                      </div>
                      <div style="font-size:11px;color:#7e729a;margin-top:2px;">Resources Audited</div>
                    </td>
                    <td width="3%"></td>
                    <!-- Attack Paths -->
                    <td width="31%" style="background:#1c132f;border:1px solid {% if attack_paths_count > 0 %}#831843{% else %}#3d266e{% endif %};border-radius:14px;padding:16px;text-align:center;">
                      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#a79bc2;">Attack Paths</div>
                      <div style="font-size:28px;font-weight:900;color:{% if attack_paths_count > 0 %}#f43f5e{% else %}#4ade80{% endif %};margin-top:6px;">
                        {{ attack_paths_count }}
                      </div>
                      <div style="font-size:11px;color:#7e729a;margin-top:2px;">Exploit Chains</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Findings Severity Breakdown Table -->
            <tr>
              <td style="padding:0 32px 24px;">
                <div style="font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#ffffff;margin-bottom:12px;">
                  Findings Summary
                </div>
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#191129;border:1px solid #2d1e4e;border-radius:12px;overflow:hidden;">
                  <tr style="border-bottom:1px solid #2d1e4e;">
                    <td style="padding:10px 16px;font-size:13px;color:#ef4444;font-weight:700;">🔴 Critical Findings</td>
                    <td align="right" style="padding:10px 16px;font-size:14px;font-weight:800;color:#ef4444;">{{ findings.critical | default(0) }}</td>
                  </tr>
                  <tr style="border-bottom:1px solid #2d1e4e;">
                    <td style="padding:10px 16px;font-size:13px;color:#f97316;font-weight:700;">🟠 High Severity</td>
                    <td align="right" style="padding:10px 16px;font-size:14px;font-weight:800;color:#f97316;">{{ findings.high | default(0) }}</td>
                  </tr>
                  <tr style="border-bottom:1px solid #2d1e4e;">
                    <td style="padding:10px 16px;font-size:13px;color:#eab308;font-weight:700;">🟡 Medium Severity</td>
                    <td align="right" style="padding:10px 16px;font-size:14px;font-weight:800;color:#eab308;">{{ findings.medium | default(0) }}</td>
                  </tr>
                  <tr style="border-bottom:1px solid #2d1e4e;">
                    <td style="padding:10px 16px;font-size:13px;color:#38bdf8;font-weight:700;">🔵 Low Severity</td>
                    <td align="right" style="padding:10px 16px;font-size:14px;font-weight:800;color:#38bdf8;">{{ findings.low | default(0) }}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 16px;font-size:13px;color:#4ade80;font-weight:700;">🟢 Passed Checks</td>
                    <td align="right" style="padding:10px 16px;font-size:14px;font-weight:800;color:#4ade80;">{{ findings.passed | default(0) }}</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Attack Graph Highlight -->
            {% if top_attack_path %}
            <tr>
              <td style="padding:0 32px 24px;">
                <div style="background:#200d23;border:1px solid #701a75;border-radius:14px;padding:18px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                      <td>
                        <span style="display:inline-block;padding:3px 10px;background:#4a044e;border-radius:6px;font-size:11px;font-weight:800;color:#f472b6;text-transform:uppercase;letter-spacing:0.05em;">
                          ⚡ Top Attack Path Identified
                        </span>
                        <h3 style="margin:10px 0 6px;font-size:15px;color:#ffffff;font-weight:800;">
                          Potential Crown Jewel Breach Path
                        </h3>
                        <p style="margin:0;font-size:13px;line-height:1.55;color:#f5d0fe;font-family:monospace;">
                          {{ top_attack_path }}
                        </p>
                      </td>
                    </tr>
                  </table>
                </div>
              </td>
            </tr>
            {% endif %}

            <!-- Call to Action Button -->
            <tr>
              <td style="padding:8px 32px 28px;text-align:center;">
                <a href="{{ dashboard_url }}" style="display:inline-block;padding:14px 34px;background:linear-gradient(92deg,#9333ea 0%,#6366f1 50%,#06b6d4 100%);color:#ffffff;font-weight:800;font-size:15px;text-decoration:none;border-radius:10px;box-shadow:0 4px 18px rgba(147,51,234,0.4);border:1px solid rgba(255,255,255,0.15);">
                  View Full Attack Graph &amp; Findings →
                </a>
              </td>
            </tr>

            <!-- Footer Section -->
            <tr>
              <td style="padding:0 32px 32px;">
                <div style="border-top:1px solid #2d1f4d;padding-top:18px;font-size:11px;color:#7e729a;line-height:1.6;">
                  This notification was dispatched to the scan initiator and shared with the security team in <strong style="color:#a79bc2;">{{ organization_name }}</strong>.<br />
                  Full executive report and remediation steps are available inside your Vrika Cloud Security workspace.
                </div>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
