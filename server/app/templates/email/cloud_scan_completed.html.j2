<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Security Audit Report — {{ organization_name }}</title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <style type="text/css">
      body, table, td { font-family: Arial, Helvetica, sans-serif !important; }
    </style>
    <![endif]-->
  </head>
  <body style="margin:0;padding:0;background-color:#eef1f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1a2332;">
    <span style="display:none;visibility:hidden;mso-hide:all;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
      {{ preheader | default('Cloud security audit complete — compliance score, findings and remediation timelines inside.') }}
    </span>

    {% set crit = findings.critical | default(0) %}
    {% set high = findings.high | default(0) %}
    {% set med = findings.medium | default(0) %}
    {% set low = findings.low | default(0) %}
    {% set total_fails = crit + high + med + low %}

    {# --- Provider logo URL mapping --- #}
    {% set provider_lower = provider | lower %}
    {% if provider_lower == 'aws' %}
      {% set provider_logo_url = 'https://raw.githubusercontent.com/devicons/devicon/master/icons/amazonwebservices/amazonwebservices-original-wordmark.svg' %}
      {% set provider_label = 'Amazon Web Services' %}
      {% set provider_badge_color = '#FF9900' %}
    {% elif provider_lower == 'azure' %}
      {% set provider_logo_url = 'https://raw.githubusercontent.com/devicons/devicon/master/icons/azure/azure-original.svg' %}
      {% set provider_label = 'Microsoft Azure' %}
      {% set provider_badge_color = '#0089D6' %}
    {% elif provider_lower in ['gcp', 'google', 'googlecloud'] %}
      {% set provider_logo_url = 'https://raw.githubusercontent.com/devicons/devicon/master/icons/googlecloud/googlecloud-original.svg' %}
      {% set provider_label = 'Google Cloud' %}
      {% set provider_badge_color = '#4285F4' %}
    {% elif provider_lower in ['kubernetes', 'k8s'] %}
      {% set provider_logo_url = 'https://raw.githubusercontent.com/devicons/devicon/master/icons/kubernetes/kubernetes-plain.svg' %}
      {% set provider_label = 'Kubernetes' %}
      {% set provider_badge_color = '#326CE5' %}
    {% elif provider_lower in ['docker', 'image'] %}
      {% set provider_logo_url = 'https://raw.githubusercontent.com/devicons/devicon/master/icons/docker/docker-original.svg' %}
      {% set provider_label = 'Container Registry' %}
      {% set provider_badge_color = '#2496ED' %}
    {% else %}
      {% set provider_logo_url = '' %}
      {% set provider_label = provider | upper %}
      {% set provider_badge_color = '#6b7685' %}
    {% endif %}

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#eef1f5;">
      <tr>
        <td align="center" style="padding:40px 16px;">

          <!-- Master Container -->
          <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;background-color:#ffffff;border:1px solid #dde3ec;border-radius:4px;">

            <!-- Vrika logo bar — top center -->
            <tr>
              <td align="center" style="padding:28px 40px 20px;border-bottom:1px solid #eef1f5;background-color:#f7f9fb;">
                <img
                  src="https://raw.githubusercontent.com/Shashank0437/vrika-website/main/public/logo.png"
                  width="40"
                  height="40"
                  alt="Vrika"
                  style="display:block;margin:0 auto 8px;width:40px;height:40px;"
                />
                <div style="font-size:13px;font-weight:700;color:#1a2332;letter-spacing:0.01em;">
                  VRIKA <span style="font-weight:500;color:#6b7685;">| Cloud Security</span>
                </div>
              </td>
            </tr>

            <!-- Wordmark bar with provider logo on right -->
            <tr>
              <td style="padding:16px 40px;border-bottom:1px solid #eef1f5;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td valign="middle" style="font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#8894a3;">
                      Security Audit Report
                    </td>
                    <td align="right" valign="middle">
                      {% if provider_logo_url %}
                      <img
                        src="{{ provider_logo_url }}"
                        width="28"
                        height="28"
                        alt="{{ provider_label }}"
                        title="{{ provider_label }}"
                        style="display:inline-block;width:28px;height:28px;vertical-align:middle;margin-right:6px;"
                      />
                      {% endif %}
                      <span style="font-size:11px;font-weight:600;color:{{ provider_badge_color }};vertical-align:middle;letter-spacing:0.04em;text-transform:uppercase;">{{ provider_label }}</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Report title + status -->
            <tr>
              <td style="padding:28px 40px 4px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td valign="top">
                      <div style="font-size:19px;font-weight:700;color:#1a2332;line-height:1.35;">
                        {{ organization_name }}
                      </div>
                    </td>
                    <td align="right" valign="top">
                      {% if crit > 0 %}
                      <span style="display:inline-block;padding:5px 12px;background-color:#fdf1f1;border:1px solid #f3c6c6;border-radius:3px;font-size:11px;font-weight:700;color:#a12626;letter-spacing:0.03em;">ACTION REQUIRED</span>
                      {% elif high > 0 %}
                      <span style="display:inline-block;padding:5px 12px;background-color:#fdf5ea;border:1px solid #f0dcb3;border-radius:3px;font-size:11px;font-weight:700;color:#8a5a10;letter-spacing:0.03em;">REVIEW NEEDED</span>
                      {% else %}
                      <span style="display:inline-block;padding:5px 12px;background-color:#eef8f1;border:1px solid #bfe3c9;border-radius:3px;font-size:11px;font-weight:700;color:#1e6b3a;letter-spacing:0.03em;">PASSED</span>
                      {% endif %}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Meta line -->
            <tr>
              <td style="padding:10px 40px 28px;">
                <div style="font-size:12.5px;color:#6b7685;line-height:1.7;border-top:1px solid #eef1f5;padding-top:16px;">
                  <strong style="color:#3a4453;">Target account</strong> &nbsp;{{ provider | upper }} &middot; {{ account_id }}{% if account_name and account_name != 'None' %} ({{ account_name }}){% endif %}
                  <br />
                  <strong style="color:#3a4453;">Scan ID</strong> &nbsp;<span style="font-family:ui-monospace,SFMono-Regular,Consolas,monospace;">{{ scan_id[:13] }}</span>
                  {% if completed_at and completed_at != 'None' %}<br /><strong style="color:#3a4453;">Completed</strong> &nbsp;{{ completed_at }}{% endif %}
                </div>
              </td>
            </tr>

            <!-- Divider -->
            <tr><td style="border-top:1px solid #eef1f5;"></td></tr>

            <!-- Stat strip -->
            <tr>
              <td style="padding:28px 40px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td width="34%" valign="top">
                      <div style="font-size:26px;font-weight:700;color:#1a2332;">{{ compliance_score }}%</div>
                      <div style="font-size:11.5px;color:#8894a3;margin-top:3px;">Compliance score</div>
                    </td>
                    <td width="33%" valign="top" style="border-left:1px solid #eef1f5;padding-left:20px;">
                      <div style="font-size:26px;font-weight:700;color:#1a2332;">{{ scanned_resources | default(0) }}</div>
                      <div style="font-size:11.5px;color:#8894a3;margin-top:3px;">Resources evaluated</div>
                    </td>
                    <td width="33%" valign="top" style="border-left:1px solid #eef1f5;padding-left:20px;">
                      <div style="font-size:26px;font-weight:700;color:{% if (crit + high) > 0 %}#a12626{% else %}#1e6b3a{% endif %};">{{ crit + high }}</div>
                      <div style="font-size:11.5px;color:#8894a3;margin-top:3px;">Critical &amp; high findings</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Divider -->
            <tr><td style="border-top:1px solid #eef1f5;"></td></tr>

            <!-- Findings table -->
            <tr>
              <td style="padding:28px 40px 8px;">
                <div style="font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#8894a3;margin-bottom:14px;">
                  Findings by severity
                </div>

                {% if total_fails > 0 %}
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="height:5px;margin-bottom:16px;">
                  <tr>
                    {% if crit > 0 %}<td width="{{ (crit / total_fails * 100) | round }}%" style="background-color:#c23b3b;font-size:0;line-height:0;">&nbsp;</td>{% endif %}
                    {% if high > 0 %}<td width="{{ (high / total_fails * 100) | round }}%" style="background-color:#d97a2e;font-size:0;line-height:0;">&nbsp;</td>{% endif %}
                    {% if med > 0 %}<td width="{{ (med / total_fails * 100) | round }}%" style="background-color:#cf9a2e;font-size:0;line-height:0;">&nbsp;</td>{% endif %}
                    {% if low > 0 %}<td width="{{ (low / total_fails * 100) | round }}%" style="background-color:#c3ccd6;font-size:0;line-height:0;">&nbsp;</td>{% endif %}
                    {% if total_fails == 0 %}<td width="100%" style="background-color:#c3ccd6;font-size:0;line-height:0;">&nbsp;</td>{% endif %}
                  </tr>
                </table>
                {% endif %}

                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;font-size:13px;">
                  <tr>
                    <td style="padding:9px 0;border-bottom:1px solid #f1f3f6;color:#3a4453;">
                      <span style="display:inline-block;width:7px;height:7px;border-radius:1px;background-color:#c23b3b;margin-right:8px;"></span>Critical
                    </td>
                    <td align="right" style="padding:9px 0;border-bottom:1px solid #f1f3f6;font-weight:600;color:#1a2332;">{{ crit }}</td>
                    <td align="right" style="padding:9px 0;border-bottom:1px solid #f1f3f6;color:#8894a3;">24 hr SLA</td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;border-bottom:1px solid #f1f3f6;color:#3a4453;">
                      <span style="display:inline-block;width:7px;height:7px;border-radius:1px;background-color:#d97a2e;margin-right:8px;"></span>High
                    </td>
                    <td align="right" style="padding:9px 0;border-bottom:1px solid #f1f3f6;font-weight:600;color:#1a2332;">{{ high }}</td>
                    <td align="right" style="padding:9px 0;border-bottom:1px solid #f1f3f6;color:#8894a3;">7 day SLA</td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;border-bottom:1px solid #f1f3f6;color:#3a4453;">
                      <span style="display:inline-block;width:7px;height:7px;border-radius:1px;background-color:#cf9a2e;margin-right:8px;"></span>Medium
                    </td>
                    <td align="right" style="padding:9px 0;border-bottom:1px solid #f1f3f6;font-weight:600;color:#1a2332;">{{ med }}</td>
                    <td align="right" style="padding:9px 0;border-bottom:1px solid #f1f3f6;color:#8894a3;">30 day SLA</td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;color:#3a4453;">
                      <span style="display:inline-block;width:7px;height:7px;border-radius:1px;background-color:#c3ccd6;margin-right:8px;"></span>Low / informational
                    </td>
                    <td align="right" style="padding:9px 0;font-weight:600;color:#1a2332;">{{ low }}</td>
                    <td align="right" style="padding:9px 0;color:#8894a3;">Periodic review</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Attached reports -->
            <tr>
              <td style="padding:24px 40px 0;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f7f9fb;border:1px solid #eef1f5;border-radius:4px;">
                  <tr>
                    <td style="padding:16px 18px;font-size:12.5px;color:#3a4453;line-height:1.8;">
                      <strong style="color:#1a2332;">Attached to this email</strong><br />
                      Executive Summary — posture overview and risk trend<br />
                      Technical Findings Report — full checks and remediation steps
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- CTA -->
            <tr>
              <td align="center" style="padding:32px 40px 36px;">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{ dashboard_url }}" style="height:42px;v-text-anchor:middle;width:230px;" arcsize="8%" fillcolor="#1a2332" stroke="f">
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;">View full report</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                <a href="{{ dashboard_url }}" target="_blank" style="display:inline-block;padding:12px 28px;background-color:#1a2332;border-radius:3px;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;letter-spacing:0.01em;">
                  View full report
                </a>
                <!--<![endif]-->
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background-color:#f7f9fb;border-top:1px solid #eef1f5;padding:20px 40px;text-align:center;font-size:11px;color:#8894a3;line-height:1.7;">
                This is an automated report from your organization's Vrika Cloud Security workspace.<br />
                Sent to authorized administrators of {{ organization_name }}.
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
